# Writes GitVersion.h with the current git commit, e.g.
#   #define GIT_VERSION "14b028e"        (or "14b028e-dirty" with local edits)
# Run at every build (see src/piXPlaneFMCCDU/CMakeLists.txt); the file is
# only rewritten when the version changes, so it doesn't force rebuilds.
#   cmake -DSRC_DIR=<repo> -DOUT_FILE=<path>/GitVersion.h -P GitVersion.cmake

set(GIT_VERSION "unknown")
find_package(Git QUIET)
if(GIT_FOUND)
    execute_process(COMMAND "${GIT_EXECUTABLE}" rev-parse --short=7 HEAD
        WORKING_DIRECTORY "${SRC_DIR}"
        OUTPUT_VARIABLE _sha OUTPUT_STRIP_TRAILING_WHITESPACE
        RESULT_VARIABLE _rc ERROR_QUIET)
    if(_rc EQUAL 0 AND _sha)
        set(GIT_VERSION "${_sha}")
        execute_process(COMMAND "${GIT_EXECUTABLE}" diff --quiet HEAD --
            WORKING_DIRECTORY "${SRC_DIR}"
            RESULT_VARIABLE _dirty ERROR_QUIET)
        if(NOT _dirty EQUAL 0)
            set(GIT_VERSION "${GIT_VERSION}-dirty")
        endif()
    endif()
endif()

set(_content "// Generated by cmake/GitVersion.cmake - do not edit\n#define GIT_VERSION \"${GIT_VERSION}\"\n")
if(EXISTS "${OUT_FILE}")
    file(READ "${OUT_FILE}" _old)
else()
    set(_old "")
endif()
if(NOT _old STREQUAL _content)
    file(WRITE "${OUT_FILE}" "${_content}")
    message(STATUS "Version: ${GIT_VERSION}")
endif()
